generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id             String              @id @default(cuid())
  competitionId  String
  name           String
  academy        String
  gender         String
  dateOfBirth    DateTime
  phone          String
  preferredDate  DateTime
  preferredSlot  String
  paymentMode    String
  paymentStatus  String
  paymentConfirmedBy String?
  paymentConfirmedAt DateTime?
  amount         Int
  utrNumber      String?
  screenshotPath String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  competition    Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entries        RegistrationEntry[]

  @@index([competitionId])
  @@index([preferredDate])
  @@index([paymentStatus])
}

model Competition {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  shortTitle        String
  description       String?
  venue             String?
  startDate         DateTime
  endDate           DateTime
  competitionYear   Int
  status            String         @default("draft")
  isPublished       Boolean        @default(false)
  registrationOpen  Boolean        @default(false)
  resultsPublished  Boolean        @default(false)
  paymentQrPath     String?
  heroImagePath     String?
  config            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]

  @@index([status])
  @@index([isPublished])
  @@index([registrationOpen])
  @@index([resultsPublished])
  @@index([startDate])
}

model RegistrationEntry {
  id             String       @id @default(cuid())
  registrationId String
  eventId        String
  eventTitle     String
  discipline     String
  ruleSet        String
  categoryCode   String
  categoryLabel  String
  fee            Int
  seriesScores   Json?
  shotScores     Json?
  seriesInnerTenCounts Json?
  innerTenCount  Int          @default(0)
  totalScore     Float?
  isPara         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([categoryCode])
  @@index([ruleSet])
}
