generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id             String              @id @default(cuid())
  competitionId  String
  name           String
  academy        String
  gender         String
  dateOfBirth    DateTime
  phone          String
  preferredDate  DateTime
  preferredSlot  String
  paymentMode    String
  paymentStatus  String
  paymentConfirmedBy String?
  paymentConfirmedAt DateTime?
  amount         Int
  utrNumber      String?
  screenshotPath String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  competition    Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entries        RegistrationEntry[]
  teamMemberships TeamEntryMember[]

  @@index([competitionId])
  @@index([preferredDate])
  @@index([paymentStatus])
}

model Competition {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  shortTitle        String
  description       String?
  venue             String?
  startDate         DateTime
  endDate           DateTime
  competitionYear   Int
  status            String         @default("draft")
  isPublished       Boolean        @default(false)
  registrationOpen  Boolean        @default(false)
  resultsPublished  Boolean        @default(false)
  paymentQrPath     String?
  heroImagePath     String?
  config            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]
  teamEntries       TeamEntry[]

  @@index([status])
  @@index([isPublished])
  @@index([registrationOpen])
  @@index([resultsPublished])
  @@index([startDate])
}

model RegistrationEntry {
  id             String       @id @default(cuid())
  registrationId String
  eventId        String
  eventTitle     String
  discipline     String
  ruleSet        String
  categoryCode   String
  categoryLabel  String
  fee            Int
  seriesScores   Json?
  shotScores     Json?
  seriesInnerTenCounts Json?
  innerTenCount  Int          @default(0)
  totalScore     Float?
  isPara         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  teamMemberships TeamEntryMember[]

  @@index([eventId])
  @@index([categoryCode])
  @@index([ruleSet])
}

model TeamEntry {
  id             String            @id @default(cuid())
  competitionId  String
  name           String
  academy        String
  discipline     String
  amount         Int               @default(900)
  paymentMode    String            @default("cash")
  paymentStatus  String            @default("Pending")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  competition    Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  members        TeamEntryMember[]

  @@index([competitionId])
  @@index([discipline])
  @@index([paymentStatus])
}

model TeamEntryMember {
  id                  String             @id @default(cuid())
  teamEntryId         String
  registrationId      String
  registrationEntryId String
  createdAt           DateTime           @default(now())
  teamEntry           TeamEntry          @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)
  registration        Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  registrationEntry   RegistrationEntry  @relation(fields: [registrationEntryId], references: [id], onDelete: Restrict)

  @@index([teamEntryId])
  @@index([registrationId])
  @@index([registrationEntryId])
}
