generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RangeUser {
  id String @id @default(cuid())
  name String
  phone String @unique
  passwordHash String
  role String @default("coach")
  active Boolean @default(true)
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships RangeMembership[]
  sessions RangeSession[]
  audits RangeAudit[]
}

model RangeLocation {
  id String @id @default(cuid())
  name String
  slug String @unique
  timeZone String @default("Asia/Kolkata")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships RangeMembership[]
  audits RangeAudit[]
}

model RangeMembership {
  userId String
  locationId String
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@id([userId, locationId])
  @@index([locationId])
}

model RangeSession {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RangeLoginAttempt {
  id String @id @default(cuid())
  phoneHash String
  ipHash String
  createdAt DateTime @default(now())
  @@index([phoneHash, createdAt])
  @@index([ipHash, createdAt])
}

model RangeAudit {
  id String @id @default(cuid())
  actorId String
  locationId String?
  action String
  entityId String
  before Json?
  after Json?
  reason String?
  createdAt DateTime @default(now())
  actor RangeUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  location RangeLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, createdAt])
  @@index([entityId])
}

model Registration {
  id             String              @id @default(cuid())
  competitionId  String
  batchId        String?
  name           String
  academy        String
  coachName      String?
  motherName     String?
  fatherName     String?
  gender         String
  dateOfBirth    DateTime
  phone          String
  address        String?
  preferredDate  DateTime
  preferredSlot  String
  paymentMode    String
  paymentStatus  String
  paymentConfirmedBy String?
  paymentConfirmedAt DateTime?
  amount         Int
  utrNumber      String?
  screenshotPath String?
  studentPhotoPath String?
  birthCertificatePath String?
  aadhaarCardPath String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  competition    Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  batch          RegistrationBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  relayBooking   RegistrationRelayBooking?
  entries        RegistrationEntry[]
  documents      RegistrationDocument[]
  teamMemberships TeamEntryMember[]

  @@index([competitionId])
  @@index([batchId])
  @@index([preferredDate])
  @@index([paymentStatus])
}

model RegistrationDocument {
  id             String       @id @default(cuid())
  registrationId String
  documentKey    String
  label          String
  path           String
  mimeType       String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, documentKey])
  @@index([registrationId])
}

model Competition {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  shortTitle        String
  description       String?
  venue             String?
  startDate         DateTime
  endDate           DateTime
  competitionYear   Int
  status            String         @default("draft")
  isPublished       Boolean        @default(false)
  registrationOpen  Boolean        @default(false)
  resultsPublished  Boolean        @default(false)
  paymentQrPath     String?
  heroImagePath     String?
  adminPinDigest    String?        @unique
  config            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]
  teamEntries       TeamEntry[]
  registrationBatches RegistrationBatch[]
  relayBookings     RegistrationRelayBooking[]

  @@index([status])
  @@index([isPublished])
  @@index([registrationOpen])
  @@index([resultsPublished])
  @@index([startDate])
}

model RegistrationBatch {
  id            String @id @default(cuid())
  competitionId String
  submissionKey String @unique
  academy       String
  coachName     String
  phone         String
  paymentMode   String
  paymentStatus String
  utrNumber     String?
  screenshotPath String?
  amount        Int
  createdAt     DateTime @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  registrations Registration[]
  @@index([competitionId])
}

model RegistrationRelayBooking {
  id             String @id @default(cuid())
  registrationId String @unique
  competitionId  String
  date           String
  relayId        String
  pool           String
  lane           Int
  createdAt      DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  @@unique([competitionId, date, relayId, pool, lane])
  @@index([competitionId, date])
}

model RegistrationEntry {
  id             String       @id @default(cuid())
  registrationId String
  eventId        String
  eventTitle     String
  discipline     String
  ruleSet        String
  categoryCode   String
  categoryLabel  String
  fee            Int
  seriesScores   Json?
  shotScores     Json?
  seriesInnerTenCounts Json?
  innerTenCount  Int          @default(0)
  totalScore     Float?
  isPara         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  teamMemberships TeamEntryMember[]

  @@index([eventId])
  @@index([categoryCode])
  @@index([ruleSet])
}

model TeamEntry {
  id             String            @id @default(cuid())
  competitionId  String
  name           String
  academy        String
  discipline     String
  amount         Int               @default(900)
  paymentMode    String            @default("cash")
  paymentStatus  String            @default("Pending")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  competition    Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  members        TeamEntryMember[]

  @@index([competitionId])
  @@index([discipline])
  @@index([paymentStatus])
}

model TeamEntryMember {
  id                  String             @id @default(cuid())
  teamEntryId         String
  registrationId      String
  registrationEntryId String
  createdAt           DateTime           @default(now())
  teamEntry           TeamEntry          @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)
  registration        Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  registrationEntry   RegistrationEntry  @relation(fields: [registrationEntryId], references: [id], onDelete: Restrict)

  @@index([teamEntryId])
  @@index([registrationId])
  @@index([registrationEntryId])
}
