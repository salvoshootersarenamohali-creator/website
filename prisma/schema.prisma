generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RangeUser {
  id String @id @default(cuid())
  name String
  phone String @unique
  passwordHash String
  role String @default("coach")
  active Boolean @default(true)
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships RangeMembership[]
  sessions RangeSession[]
  audits RangeAudit[]
  shifts RangeShift[]
  challenges RangeAttendanceChallenge[]
  corrections RangeCorrection[]
  enrollments RangeEnrollment[]
  studentMarks RangeStudentAttendance[]
  moneyAccounts RangeMoneyAccount[]
  financeCreated RangeFinanceTransaction[] @relation("FinanceCreator")
  financeRecorded RangeFinanceTransaction[] @relation("FinanceRecorder")
  transfersRequested RangeTransfer[]
  salaryPayments RangeSalaryPayment[]
}

model RangeLocation {
  id String @id @default(cuid())
  name String
  slug String @unique
  timeZone String @default("Asia/Kolkata")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships RangeMembership[]
  audits RangeAudit[]
  shifts RangeShift[]
  challenges RangeAttendanceChallenge[]
  corrections RangeCorrection[]
  enrollments RangeEnrollment[]
  moneyAccounts RangeMoneyAccount[]
  products RangeProduct[]
  financeCategories RangeFinanceCategory[]
  financeTransactions RangeFinanceTransaction[]
  transfers RangeTransfer[]
}

model RangeMoneyAccount {
  id String @id @default(cuid())
  locationId String
  name String
  custodian String
  coachId String?
  channel String
  openingPaise Int @default(0)
  openingDate String
  active Boolean @default(true)
  version Int @default(1)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  coach RangeUser? @relation(fields: [coachId], references: [id], onDelete: Restrict)
  movements RangeMoneyMovement[]
  transfersFrom RangeTransfer[] @relation("TransferFrom")
  transfersTo RangeTransfer[] @relation("TransferTo")
  @@index([locationId])
}

model RangeProduct {
  id String @id @default(cuid())
  locationId String
  name String
  unit String @default("item")
  defaultPricePaise Int
  active Boolean @default(true)
  version Int @default(1)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  transactions RangeFinanceTransaction[]
  @@index([locationId])
}

model RangeFinanceCategory {
  id String @id @default(cuid())
  locationId String
  name String
  kind String
  active Boolean @default(true)
  version Int @default(1)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  transactions RangeFinanceTransaction[]
  @@unique([locationId, name, kind])
}

model RangeFinanceTransaction {
  id String @id @default(cuid())
  locationId String
  createdById String
  recordedById String
  kind String
  source String @default("manual")
  categoryId String
  categoryName String
  amountPaise Int
  occurredOn String
  description String
  productId String?
  productName String?
  quantity Int?
  unitPricePaise Int?
  status String @default("posted")
  submissionKey String @unique
  submissionHash String
  correctsId String? @unique
  refundOfId String?
  receiptId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy RangeUser @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recordedBy RangeUser @relation("FinanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  product RangeProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  category RangeFinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  corrects RangeFinanceTransaction? @relation("FinanceCorrections", fields: [correctsId], references: [id], onDelete: Restrict)
  replacement RangeFinanceTransaction? @relation("FinanceCorrections")
  refundOf RangeFinanceTransaction? @relation("FinanceRefunds", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds RangeFinanceTransaction[] @relation("FinanceRefunds")
  movements RangeMoneyMovement[]
  studentFee RangeStudentFee?
  transfer RangeTransfer?
  salaryPayment RangeSalaryPayment?
  @@index([locationId, occurredOn])
  @@index([recordedById])
}

model RangeSalaryPayment {
  id String @id @default(cuid())
  transactionId String @unique
  coachId String
  salaryMonth String
  notes String?
  transaction RangeFinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  coach RangeUser @relation(fields: [coachId], references: [id], onDelete: Restrict)
  @@index([coachId, salaryMonth])
}

model RangeTransfer {
  id String @id @default(cuid())
  locationId String
  requestedById String
  fromAccountId String
  toAccountId String
  amountPaise Int
  occurredOn String
  notes String
  reference String?
  status String @default("pending")
  transactionId String? @unique
  resolvedById String?
  resolvedAt DateTime?
  resolution String?
  submissionKey String @unique
  submissionHash String
  version Int @default(1)
  createdAt DateTime @default(now())
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  requestedBy RangeUser @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  fromAccount RangeMoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount RangeMoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  transaction RangeFinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  @@index([locationId, status])
}

model RangeStudentFee {
  id String @id @default(cuid())
  transactionId String @unique
  enrollmentId String
  type String
  months Int
  coverageStart String
  coverageEnd String
  notes String?
  transaction RangeFinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  enrollment RangeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  @@index([enrollmentId, coverageStart])
}

model RangeMoneyMovement {
  id String @id @default(cuid())
  transactionId String
  accountId String
  amountPaise Int
  method String
  reference String?
  transaction RangeFinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account RangeMoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId])
  @@index([transactionId])
}

model RangeShooterProfile {
  id String @id @default(cuid())
  name String
  phone String?
  guardianName String?
  guardianPhone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollments RangeEnrollment[]
  @@index([name])
}

model RangeEnrollment {
  id String @id @default(cuid())
  profileId String
  locationId String
  discipline String
  startDate String
  endDate String?
  active Boolean @default(true)
  createdById String
  submissionKey String @unique
  submissionHash String
  version Int @default(1)
  createdAt DateTime @default(now())
  profile RangeShooterProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy RangeUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attendance RangeStudentAttendance[]
  fees RangeStudentFee[]
  @@unique([profileId, locationId])
  @@index([locationId, active])
}

model RangeStudentAttendance {
  id String @id @default(cuid())
  enrollmentId String
  date String
  status String
  markedById String
  submissionKey String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollment RangeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  markedBy RangeUser @relation(fields: [markedById], references: [id], onDelete: Restrict)
  @@unique([enrollmentId, date])
  @@index([date])
}

model RangeShift {
  id String @id @default(cuid())
  userId String
  locationId String
  inAt DateTime
  outAt DateTime?
  originalInAt DateTime?
  originalOutAt DateTime?
  inPhoto String?
  outPhoto String?
  adjusted Boolean @default(false)
  openKey String? @unique
  version Int @default(1)
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, inAt])
  @@index([userId, inAt])
}

model RangeAttendanceChallenge {
  id String @id @default(cuid())
  userId String
  locationId String
  action String
  shiftId String?
  expiresAt DateTime
  usedAt DateTime?
  outcomeShiftId String?
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
}

model RangeCorrection {
  id String @id @default(cuid())
  userId String
  locationId String
  kind String
  entityId String
  reason String
  proposed Json
  status String @default("pending")
  resolution String?
  resolvedById String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, status])
}

model RangeMembership {
  userId String
  locationId String
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  location RangeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@id([userId, locationId])
  @@index([locationId])
}

model RangeSession {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user RangeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RangeLoginAttempt {
  id String @id @default(cuid())
  phoneHash String
  ipHash String
  createdAt DateTime @default(now())
  @@index([phoneHash, createdAt])
  @@index([ipHash, createdAt])
}

model RangeAudit {
  id String @id @default(cuid())
  actorId String
  locationId String?
  action String
  entityId String
  before Json?
  after Json?
  reason String?
  createdAt DateTime @default(now())
  actor RangeUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  location RangeLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, createdAt])
  @@index([entityId])
}

model Registration {
  id             String              @id @default(cuid())
  competitionId  String
  batchId        String?
  name           String
  academy        String
  coachName      String?
  motherName     String?
  fatherName     String?
  gender         String
  dateOfBirth    DateTime
  phone          String
  address        String?
  preferredDate  DateTime
  preferredSlot  String
  paymentMode    String
  paymentStatus  String
  paymentConfirmedBy String?
  paymentConfirmedAt DateTime?
  amount         Int
  utrNumber      String?
  screenshotPath String?
  studentPhotoPath String?
  birthCertificatePath String?
  aadhaarCardPath String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  competition    Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  batch          RegistrationBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  relayBooking   RegistrationRelayBooking?
  entries        RegistrationEntry[]
  documents      RegistrationDocument[]
  teamMemberships TeamEntryMember[]

  @@index([competitionId])
  @@index([batchId])
  @@index([preferredDate])
  @@index([paymentStatus])
}

model RegistrationDocument {
  id             String       @id @default(cuid())
  registrationId String
  documentKey    String
  label          String
  path           String
  mimeType       String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, documentKey])
  @@index([registrationId])
}

model Competition {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  shortTitle        String
  description       String?
  venue             String?
  startDate         DateTime
  endDate           DateTime
  competitionYear   Int
  status            String         @default("draft")
  isPublished       Boolean        @default(false)
  registrationOpen  Boolean        @default(false)
  resultsPublished  Boolean        @default(false)
  paymentQrPath     String?
  heroImagePath     String?
  adminPinDigest    String?        @unique
  config            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  registrations     Registration[]
  teamEntries       TeamEntry[]
  registrationBatches RegistrationBatch[]
  relayBookings     RegistrationRelayBooking[]

  @@index([status])
  @@index([isPublished])
  @@index([registrationOpen])
  @@index([resultsPublished])
  @@index([startDate])
}

model RegistrationBatch {
  id            String @id @default(cuid())
  competitionId String
  submissionKey String @unique
  academy       String
  coachName     String
  phone         String
  paymentMode   String
  paymentStatus String
  utrNumber     String?
  screenshotPath String?
  amount        Int
  createdAt     DateTime @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  registrations Registration[]
  @@index([competitionId])
}

model RegistrationRelayBooking {
  id             String @id @default(cuid())
  registrationId String @unique
  competitionId  String
  date           String
  relayId        String
  pool           String
  lane           Int
  createdAt      DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  @@unique([competitionId, date, relayId, pool, lane])
  @@index([competitionId, date])
}

model RegistrationEntry {
  id             String       @id @default(cuid())
  registrationId String
  eventId        String
  eventTitle     String
  discipline     String
  ruleSet        String
  categoryCode   String
  categoryLabel  String
  fee            Int
  seriesScores   Json?
  shotScores     Json?
  seriesInnerTenCounts Json?
  innerTenCount  Int          @default(0)
  totalScore     Float?
  isPara         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  teamMemberships TeamEntryMember[]

  @@index([eventId])
  @@index([categoryCode])
  @@index([ruleSet])
}

model TeamEntry {
  id             String            @id @default(cuid())
  competitionId  String
  name           String
  academy        String
  discipline     String
  amount         Int               @default(900)
  paymentMode    String            @default("cash")
  paymentStatus  String            @default("Pending")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  competition    Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  members        TeamEntryMember[]

  @@index([competitionId])
  @@index([discipline])
  @@index([paymentStatus])
}

model TeamEntryMember {
  id                  String             @id @default(cuid())
  teamEntryId         String
  registrationId      String
  registrationEntryId String
  createdAt           DateTime           @default(now())
  teamEntry           TeamEntry          @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)
  registration        Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  registrationEntry   RegistrationEntry  @relation(fields: [registrationEntryId], references: [id], onDelete: Restrict)

  @@index([teamEntryId])
  @@index([registrationId])
  @@index([registrationEntryId])
}
